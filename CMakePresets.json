{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 30, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },

    {
      "name": "default",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/default/L10",
      "cacheVariables": {
        "NICKELCUT_L": "10"
      }
    },

    {
      "name": "lw-generator",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/lw-generator/L10",
      "cacheVariables": {
        "NICKELCUT_L": "10",
        "USE_LW_GENERATOR": "ON"
      }
    },

    {
      "name": "cascadelake",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/cascadelake/L10",
      "cacheVariables": {
        "NICKELCUT_L": "10",
        "TARGET_ARCH": "cascadelake"
      }
    },

    {
      "name": "icelake",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/icelake/L10",
      "cacheVariables": {
        "NICKELCUT_L": "10",
        "TARGET_ARCH": "icelake"
      }
    },

    {
      "name": "debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug/L10",
      "cacheVariables": {
        "NICKELCUT_L": "10",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "BetaTest",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/BetaTest/L10",
      "cacheVariables": {
        "NICKELCUT_L": "10",
        "CMAKE_BUILD_TYPE": "BetaTest"
      }
    },
    
    {
      "name": "test",
      "inherits": "default",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "lw-generator",
      "configurePreset": "lw-generator"
    },
    {
      "name": "test",
      "configurePreset": "test"
    },
    {
      "name": "cascadelake",
      "configurePreset": "cascadelake"
    },
    {
      "name": "icelake",
      "configurePreset": "icelake"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "BetaTest",
      "configurePreset": "BetaTest"
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}